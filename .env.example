# 이 파일을 .env로 복사하면 값을 바꿀 수 있습니다. 비밀 값은 없습니다.
# 값이 없으면 아래 기본값을 씁니다.

# 글 데이터베이스(SQLite 파일). 프로젝트 폴더 기준 경로입니다.
DATABASE_URL=file:data/blog.db

# 사진 원본과 크기별 사진을 두는 폴더
UPLOAD_DIR=uploads

# 블로그 서버 포트
PORT=3000

# 1로 두면 글쓴이 판단(localhost)을 끄고 글쓰기를 모두 막습니다. 인터넷에 공개할 때 씁니다.
# BLOG_PUBLIC_MODE=1

# 사이트 이름(정해지면 바꿉니다)
# NEXT_PUBLIC_SITE_NAME=[SITE NAME]
